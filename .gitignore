# Secrets & Environment Variables
.env
*.local.env

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# Obsidian local workspace cache (keeps settings, ignores open tabs/window states)
.obsidian/workspace*
.obsidian/cache/
.obsidian/plugins/obsidian-git/

# Neovim / Vim swap and backup files
*.swp
*.swo
*~
.netrwhist

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs & temp files
*.log
tmp/

# Local search database cache (regenerated via tools/indexer.py)
data/*.db
data/*.sqlite

# Large raw archives & exports (unpacked or raw dumps)
*.zip
*.tar.gz
*.tgz
*.mbox
raw/**/_tmp*

# Node.js / Monorepo artifacts
node_modules/
dist/
*.tsbuildinfo

# Large audio/video binaries (>50MB prevention)
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.iso

# Credentials & SSH Keys
*.pem
*.key
id_rsa*
id_ed25519*



# Copy to .env locally/on VPS. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Real model IDs available to your account. No guessed/free-model cascade.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GROQ_API_KEY=
GROQ_MODEL=
# Optional audio providers (Groq -> OpenAI -> Gemini).
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
# Optional local Whisper: installed library + an existing model file, no auto-download.
# LOCAL_WHISPER_MODEL=/absolute/path/to/base.pt
SECOND_BRAIN_MAX_DOWNLOAD_MB=20
SECOND_BRAIN_INCLUDE_PRIVATE=0
# Enables /sync push of committed changes, never git add/commit.
SECOND_BRAIN_ALLOW_GIT_SYNC=0
